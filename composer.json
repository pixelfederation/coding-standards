{
  "name": "pixelfederation/coding-standards",
  "description": "Standardized PHPCS sniffs for backend developers.",
  "license": "BSD-3-Clause",
  "type": "phpcodesniffer-standard",
  "authors": [
    {
      "name": "Martin Fris",
      "email": "mfris@pixelfederation.com"
    }
  ],
  "homepage": "https://github.com/pixelfederation/coding-standards",
  "require": {
    "php": "^8.4",
    "slevomat/coding-standard": "^8.31.1",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "require-dev": {
    "ext-dom": "*",
    "ext-libxml": "*",
    "ergebnis/composer-normalize": "^2.56",
    "friendsofphp/php-cs-fixer": "^3.95.28",
    "friendsoftwig/twigcs": "^6.6.1",
    "nikic/php-parser": "^5.9",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpro/grumphp": "^2.26",
    "phpstan/phpstan": "^2.3.5",
    "phpunit/phpunit": "^13.4.6"
  },
  "suggest": {
    "friendsoftwig/twigcs": "Required to use the Pixel Federation Twigcs ruleset (^6.6.1)."
  },
  "autoload": {
    "psr-4": {
      "PixelFederation\\CodingStandards\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PixelFederation\\CodingStandards\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "phpro/grumphp": true
    },
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "auto-scripts": {
      "normalizer": "composer normalize"
    },
    "phpcbf8.4": "phpcbf --standard=phpcs.ruleset.84.xml tests/Example",
    "phpcbf8.5": "phpcbf --standard=phpcs.ruleset.85.xml tests/Example",
    "phpcs8.4": "phpcs --standard=phpcs.ruleset.84.xml tests/Example",
    "phpcs8.5": "phpcs --standard=phpcs.ruleset.85.xml tests/Example",
    "phpunit": "vendor/bin/phpunit --configuration=phpunit.xml --colors=always"
  }
}
